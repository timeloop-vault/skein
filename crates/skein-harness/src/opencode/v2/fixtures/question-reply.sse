data: {"id":"evt_1882a86f9001WxQ1HUgxZ13eDz","created":1793285850873,"type":"session.tool.success","location":{"directory":"C:\\work\\proj"},"data":{"sessionID":"ses_e77d58794ffeObfYpP7mdzpMC0","assistantMessageID":"msg_1882a7fda0010ZnKANG2Y14Y9Q","id":"call_00_pmnjsw8gtemba2j7b55th6ar","content":[{"type":"text","text":"{\n  \"items\": [\n    {\n      \"path\": \"tools.opencode.read_mcp_resource\",\n      \"description\": \"Read one MCP resource by server and URI. Not for local files. Always return the full contents rather than slicing or filtering them; oversized output is truncated automatically and the full content is saved to a file you can read. Images and PDFs are shown to you directly.\",\n      \"signature\": \"tools.opencode.read_mcp_resource({\\n  /** The server field of the discovered resource. */\\n  server: string,\\n  /** Exact resource URI from discovery, an expanded uriTemplate, or the user. */\\n  uri: string,\\n}): Promise<{\\n  server: string,\\n  uri: string,\\n  contents: Array<{\\n        type: \\\"text\\\",\\n        uri: string,\\n        text: string,\\n        mimeType?: string,\\n      } | {\\n        type: \\\"blob\\\",\\n        uri: string,\\n        blob: string,\\n        mimeType?: string,\\n      }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.session_rename\",\n      \"description\": \"Rename a session, or omit sessionID to rename the current session. Use a short, specific title that summarizes the work being done.\",\n      \"signature\": \"tools.opencode.session_rename({\\n  /** Omit to rename the current session. @pattern ^ses */\\n  sessionID?: string,\\n  /** New session title. @minLength 1 */\\n  title: string,\\n}): Promise<{\\n  /** @pattern ^ses */\\n  sessionID: string,\\n  title: string,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.worktree_create\",\n      \"description\": \"Create a named worktree. Returns its directory.\",\n      \"signature\": \"tools.opencode.worktree_create({\\n  name: string,\\n}): Promise<{\\n  directory: string,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.list_mcp_resources\",\n      \"description\": \"List documents, records, and other data exposed by MCP servers. Use this when the user refers to something that is not a local file, such as a URI with a custom scheme, then load a match with read_mcp_resource. Each entry names the server to read it from. Templates are resources addressed by a parameter such as a record ID; fill in the uriTemplate placeholders before reading.\",\n      \"signature\": \"tools.opencode.list_mcp_resources({\\n  /** MCP server name as configured. Omit to list every server. */\\n  server?: string,\\n}): Promise<{\\n  resources: Array<{\\n      server: string,\\n      name: string,\\n      uri: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n  templates: Array<{\\n      server: string,\\n      name: string,\\n      uriTemplate: string,\\n      description?: string,\\n      mimeType?: string,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.models\",\n      \"description\": \"Search the models available to use. Use this to turn a model name the user mentions into an exact reference before running a subagent on it. Check your own provider first.\",\n      \"signature\": \"tools.opencode.models({\\n  /** Text to search for in model names and IDs. */\\n  query?: string,\\n  /** Provider ID or name to filter by. Try your own provider first. */\\n  provider?: string,\\n  /** Include older versions of each model family. By default only the newest version is listed. */\\n  all?: boolean,\\n  /** Maximum number of models to return. Defaults to 20. @integer @minimum 1 @maximum 100 */\\n  limit?: number,\\n  /** Number of models to skip, for paging through results. @integer @minimum 0 */\\n  offset?: number,\\n}): Promise<{\\n  /** Matching models grouped by provider. Your own provider comes first. */\\n  providers: Array<{\\n      id: string,\\n      name: string,\\n      /** Newest first. */\\n      models: Array<{\\n          /** providerID/modelID */\\n          id: string,\\n          name: string,\\n          /** Release date as a Unix timestamp in milliseconds, or 0 when unknown. */\\n          released: number,\\n          variants: Array<string>,\\n          /** Pricing in USD per million tokens. */\\n          cost: Array<{\\n              tier?: {\\n                type: \\\"context\\\",\\n                /** @integer */\\n                size: number,\\n              },\\n              input: number,\\n              output: number,\\n              cache: {\\n                read: number,\\n                write: number,\\n              },\\n            }>,\\n          status: \\\"alpha\\\" | \\\"beta\\\" | \\\"deprecated\\\" | \\\"active\\\",\\n        }>,\\n    }>,\\n  /** Number of matching models across all pages. @integer */\\n  total: number,\\n  /** Offset of the next page, or null on the last page. */\\n  next: number | null,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.worktree_remove\",\n      \"description\": \"Remove a worktree. The repository location selects configuration; directory identifies the worktree to remove.\",\n      \"signature\": \"tools.opencode.worktree_remove({\\n  /** Absolute path of the worktree to remove. @minLength 1 */\\n  directory: string,\\n  /** Discard modified and untracked files. Only set this when the user has confirmed forced removal. */\\n  force?: boolean,\\n}): Promise<{\\n  directory: string,\\n  removed: boolean,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.session_move\",\n      \"description\": \"Move a session to another directory, or omit sessionID to move the current session. The current session moves at the next safe boundary; do not run destination-dependent tools in the same execute call.\",\n      \"signature\": \"tools.opencode.session_move({\\n  /** Omit to move the current session. @pattern ^ses */\\n  sessionID?: string,\\n  /** Destination directory, relative to the target session's directory or absolute. Supports ~. @minLength 1 */\\n  directory: string,\\n}): Promise<{\\n  /** @pattern ^ses */\\n  sessionID: string,\\n  directory: string,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.worktree_list\",\n      \"description\": \"List a repository's worktrees.\",\n      \"signature\": \"tools.opencode.worktree_list(): Promise<{\\n  worktrees: Array<{\\n      directory: string,\\n      strategy?: string,\\n    }>,\\n}>\"\n    }\n  ],\n  \"remaining\": 0,\n  \"next\": null\n}"}],"metadata":{"toolCalls":[{"tool":"search","status":"completed","input":{"query":"ask user a question multiple choice"}}],"truncated":false},"executed":false},"durable":{"aggregateID":"ses_e77d58794ffeObfYpP7mdzpMC0","seq":21,"version":2}}

