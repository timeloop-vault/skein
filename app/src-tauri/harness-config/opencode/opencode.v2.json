{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"servers": {
			"skein": {
				"type": "remote",
				"url": "{env:SKEIN_REVIEW_URL}",
				"disabled": false,
				"codemode": false,
				"headers": {
					"Authorization": "Bearer {env:SKEIN_REVIEW_TOKEN}",
					"X-Skein-Harness": "{env:SKEIN_HARNESS_ID}"
				}
			}
		}
	}
}
