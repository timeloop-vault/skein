#!/usr/bin/env bash
# Pre-commit hook: enforces Rust + TypeScript quality gates.
# Fails fast on first error to keep feedback loop short.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "=== pre-commit: file size (warn only, #452) ==="
sh "$REPO_ROOT/.githooks/size-check" || true

echo "=== pre-commit: cargo fmt (workspace) ==="
# --all: with a virtual root manifest and more than one member, plain
# `cargo fmt` fails with "Failed to find targets" (#209 added the 2nd crate).
cargo fmt --all --check --manifest-path "$REPO_ROOT/Cargo.toml" 2>&1 || {
    echo "ERROR: cargo fmt check failed in workspace. Run 'cargo fmt' and re-stage."
    exit 1
}

echo "=== pre-commit: cargo fmt (tauri app) ==="
cargo fmt --check --manifest-path "$REPO_ROOT/app/src-tauri/Cargo.toml" 2>&1 || {
    echo "ERROR: cargo fmt check failed in app/src-tauri. Run 'cargo fmt' and re-stage."
    exit 1
}

echo "=== pre-commit: cargo clippy (workspace) ==="
cargo clippy --manifest-path "$REPO_ROOT/Cargo.toml" --workspace --tests -- -D warnings 2>&1 || {
    echo "ERROR: clippy warnings in workspace. Fix them before committing."
    exit 1
}

echo "=== pre-commit: cargo clippy (tauri app) ==="
cargo clippy --manifest-path "$REPO_ROOT/app/src-tauri/Cargo.toml" --tests -- -D warnings 2>&1 || {
    echo "ERROR: clippy warnings in tauri app. Fix them before committing."
    exit 1
}

# Only the pure-Rust, cfg-heavy crates are checked per target: skein-git,
# skein-harness and app/src-tauri pull C build scripts (libgit2/zlib, sqlite,
# dbus, objc2) that need a target C toolchain to cross-compile. ci.yml is the
# full check. This exists because release.yml builds with -D warnings, and a
# helper that is dead code on another OS failed v0.5.3.
echo "=== pre-commit: cross-target clippy (warn only) ==="
if command -v rustup >/dev/null 2>&1; then
    host=$(rustc -vV | sed -n 's/^host: //p') || true
    installed=$(rustup target list --installed) || true
    for t in x86_64-unknown-linux-gnu aarch64-apple-darwin x86_64-pc-windows-msvc; do
        [ "$t" = "$host" ] && continue
        if ! echo "$installed" | grep -qx "$t"; then
            echo "skipped: target $t not installed (rustup target add $t)"
            continue
        fi
        cargo clippy --manifest-path "$REPO_ROOT/Cargo.toml" -p skein-sysload -p skein-procprio -p skein-review -p skein-webshot -p skein-winnotify --all-targets --target "$t" -- -D warnings 2>&1 || {
            echo "WARNING: clippy failed for target $t. release.yml builds with -D warnings, so this would fail the release."
        }
    done
else
    echo "skipped: rustup not on PATH"
fi

echo "=== pre-commit: cargo test (workspace) ==="
cargo test --manifest-path "$REPO_ROOT/Cargo.toml" --workspace 2>&1 || {
    echo "ERROR: workspace tests failed. Fix them before committing."
    exit 1
}

# The tauri crate is excluded from the workspace, so --workspace never
# reaches its unit tests. Run them explicitly — they guard the harness
# parsers and room persistence, where most shipped regressions have
# lived (#168).
echo "=== pre-commit: cargo test (tauri app) ==="
cargo test --manifest-path "$REPO_ROOT/app/src-tauri/Cargo.toml" 2>&1 || {
    echo "ERROR: tauri app tests failed. Fix them before committing."
    exit 1
}

echo "=== pre-commit: tsc ==="
cd "$REPO_ROOT/app"
npx tsc --noEmit 2>&1 || {
    echo "ERROR: TypeScript type errors. Fix them before committing."
    exit 1
}

echo "=== pre-commit: vitest ==="
# Frontend unit tests (#169). The frontend is where nearly every shipped
# regression has lived, and it had no gate at all until now.
npx vitest run 2>&1 || {
    echo "ERROR: frontend tests failed. Fix them before committing."
    exit 1
}

echo "=== pre-commit: biome ==="
npx biome check . 2>&1 || {
    echo "ERROR: Biome errors. Run 'npx biome check --write --unsafe .' in app/ and re-stage."
    exit 1
}

cd "$REPO_ROOT"

echo "=== pre-commit: all checks passed ==="
